# Copy this file to .env and adjust values for your environment.

# Root directory where converted images and project folders are stored.
IMAGE_STORAGE_ROOT=./image_storage

# SQLite index file path. Leave empty to use IMAGE_STORAGE_ROOT/.file_index.db
IMAGE_INDEX_DB=

# Set to false to disable SQLite index and use in-memory index (non-persistent cache).
IMAGE_INDEX_ENABLED=true

# FastAPI/Uvicorn bind settings.
IMAGE_SERVER_HOST=0.0.0.0
IMAGE_SERVER_PORT=5000

# Client base URL used by client_example.py
IMAGE_SERVER_URL=http://localhost:5000

# Base URL prefix for download URLs returned in API responses.
# When set, download URLs become absolute (e.g. https://data.dh.gu.se/munch/converted/16/2/...).
# Leave empty to return relative paths (/downloads/...).
IMAGE_DOWNLOAD_BASE_URL=

# Pillow decompression bomb protection. Set to:
# - default  -> use app default (currently unlimited)
# - none     -> unlimited
# - integer  -> max pixel count
IMAGE_MAX_IMAGE_PIXELS=default
